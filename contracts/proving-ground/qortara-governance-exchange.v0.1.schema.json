{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qortara.com/contracts/proving-ground/qortara-governance-exchange.v0.1.schema.json",
  "title": "Qortara Governance Exchange 0.1",
  "description": "Prototype host-neutral governance exchange. Qortara normalizes execution semantics while preserving provider-native identity and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "operation_id",
    "action",
    "result"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "effect": {
                "const": "allow"
              }
            },
            "required": ["effect"]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "provider": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                },
                "required": ["status"]
              }
            },
            "required": ["provider"]
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(sha256|sha512):[A-Fa-f0-9]+$"
    },
    "string_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "agent_id",
        "capability"
      ],
      "properties": {
        "principal_id": {
          "$ref": "#/$defs/string_ref"
        },
        "principal_type": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "$ref": "#/$defs/string_ref"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "$ref": "#/$defs/string_ref"
        },
        "input_digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime_context": {
          "type": "object",
          "additionalProperties": true
        },
        "policy_context_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string_ref"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string_ref"
          },
          "uniqueItems": true
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "reason_codes",
        "qortara",
        "provider"
      ],
      "properties": {
        "effect": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "require_approval",
            "inconclusive"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "qortara": {
          "$ref": "#/$defs/qortara_result"
        },
        "provider": {
          "$ref": "#/$defs/provider_result"
        }
      }
    },
    "qortara_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapter_version",
        "decision_id",
        "decided_at"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "transport": {
          "type": "string",
          "enum": [
            "in_process",
            "http",
            "other"
          ]
        }
      }
    },
    "provider_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unavailable",
            "unsupported",
            "error",
            "not_exercised"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "intervention_point": {
          "type": "string",
          "minLength": 1
        },
        "runtime_profile": {
          "type": "string",
          "minLength": 1
        },
        "native_effect": {
          "type": "string",
          "minLength": 1
        },
        "native_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_ref": {
          "$ref": "#/$defs/string_ref"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "receipt_ref": {
          "$ref": "#/$defs/string_ref"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "native_payload_ref": {
          "$ref": "#/$defs/string_ref"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
